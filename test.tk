.code
	addi r1, 3
	addi r2, 7
	and r3, r2, r1
	out r3, r2
; should print 3
	addi r1, 3
	addi r2, 7
	or r3, r2, r1
	out r3, r2
; should print 7
	addi r1, 3
	addi r2, 7
	xor r3, r2, r1
	out r3, r2
; should print 4
	addi r1, 1
	not r2, r1
	out r2, r1
; should print 2^64 - 2
	addi r1, 3
	addi r2, 2
	shftr r2, r2, r1
	out r2, r1
; should print 12
	addi r1, 3
	shftri r2, 3
	out r2, r1
; should print 24